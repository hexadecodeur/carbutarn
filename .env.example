# Auth session (magic link)
SESSION_SECRET=change-me-to-a-long-random-string
MAGIC_LINK_SECRET=change-me-to-another-long-random-string

# Public URL of the app (no trailing slash) — used in magic link emails
APP_URL=http://localhost:5173

# Neon Postgres
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Resend (https://resend.com) — API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxx
# Sans domaine vérifié : uniquement onboarding@resend.dev
# et tu ne peux envoyer qu’à l’e-mail du compte Resend.
# Avec domaine vérifié : CarbuTarn <noreply@ton-domaine.fr>
EMAIL_FROM="CarbuTarn <onboarding@resend.dev>"

# Vercel Cron → Authorization: Bearer …
CRON_SECRET=change-me-cron-secret

# Optional: override API listen port for local `pnpm dev:api`
API_PORT=8787
