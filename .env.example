# Auth session (magic link) — ≥ 32 caractères, pas de préfixe change-me
SESSION_SECRET=replace-with-32plus-char-random-session-secret
MAGIC_LINK_SECRET=replace-with-32plus-char-random-magic-pepper

# Public URL of the app (no trailing slash) — CORS, JWT iss/aud, magic links
APP_URL=http://localhost:5173

# Neon Postgres
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Resend (https://resend.com) — obligatoire en production
RESEND_API_KEY=re_xxxxxxxx
# Sans domaine vérifié : uniquement onboarding@resend.dev
# et tu ne peux envoyer qu’à l’e-mail du compte Resend.
# Avec domaine vérifié : CarbuTarn <noreply@ton-domaine.fr>
EMAIL_FROM="CarbuTarn <onboarding@resend.dev>"

# Vercel Cron → Authorization: Bearer … (≥ 16 caractères)
CRON_SECRET=replace-with-long-random-cron-secret

# Cloudflare Turnstile (obligatoire en production)
# Site key = publique (servie via GET /api/auth/turnstile) — pas de préfixe VITE_
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Dev only : loguer le magic link dans le terminal de `pnpm dev:api` (jamais en prod)
MAGIC_LINK_DEV_LOG=1

# Tuiles carte MapTiler (stores) — pas de préfixe VITE_
# Servie via GET /api/map/tiles ; restreindre la clé aux hostnames (localhost + prod)
MAPTILER_API_KEY=

# Overpass live (désactivé par défaut — snapshot public/osm-brands-tarn.json)
# VITE_OSM_OVERPASS=1

# Optional: override API listen port for local `pnpm dev:api`
API_PORT=8787
